WHATSNEW_BACKEND_IMAGE=whatsnew-backend:0.1.0
WHATSNEW_FRONTEND_IMAGE=whatsnew-frontend:0.1.0
WHATSNEW_PLATFORM=linux/amd64

WHATSNEW_BIND_ADDRESS=0.0.0.0
WHATSNEW_FRONTEND_PORT=19992
WHATSNEW_BACKEND_BIND_ADDRESS=127.0.0.1
WHATSNEW_BACKEND_PORT=19993

WHATSNEW_CONFIG_DIR=./runtime/config
WHATSNEW_DATA_DIR=./runtime/data

WHATSNEW_PUID=1000
WHATSNEW_PGID=1000
WHATSNEW_TIMEZONE=Asia/Shanghai
WHATSNEW_LOG_MAX_SIZE=10m
WHATSNEW_LOG_MAX_FILES=3
