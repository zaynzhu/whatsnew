{
  "name": "@whatsnew/backend",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "seed": "tsx src/scripts/seed.ts",
    "sync:tvmaze": "tsx src/scripts/syncTvmaze.ts",
    "sync:tmdb": "tsx src/scripts/syncTmdb.ts",
    "sync:thetvdb": "tsx src/scripts/syncTheTvdb.ts",
    "sync:trakt": "tsx src/scripts/syncTrakt.ts",
    "sync:youku": "tsx src/scripts/syncYouku.ts",
    "sync:iqiyi": "tsx src/scripts/syncIqiyi.ts",
    "sync:netflix": "tsx src/scripts/syncNetflix.ts",
    "sync:hulu": "tsx src/scripts/syncHulu.ts",
    "sync:disney-plus": "tsx src/scripts/syncDisneyPlus.ts",
    "sync:max": "tsx src/scripts/syncMax.ts",
    "download:imdb": "tsx src/scripts/downloadImdb.ts",
    "sync:imdb": "tsx src/scripts/syncImdb.ts",
    "test": "tsx src/scripts/prepareTestDatabase.ts && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@whatsnew/shared": "0.1.0",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^5.0.1",
    "node-cron": "^3.0.3",
    "undici": "^6.19.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^20.14.15",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^6.0.2",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
