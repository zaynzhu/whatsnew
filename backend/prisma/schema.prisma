generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model MediaItem {
  id                  String   @id @default(cuid())
  mediaType           String
  releaseForm         String
  sourceContentType   String?
  titleDisplay        String
  titleOriginal       String?
  titleAliases        String   @default("[]")
  overview            String?  @db.Text
  posterUrl           String?  @db.Text
  productionCountries String   @default("[]")
  originalLanguage    String?
  genres              String   @default("[]")
  firstReleaseDate    String?
  status              String   @default("unknown")
  heatScore           Float    @default(0)
  tmdbId              Int?
  tvmazeId            Int?
  imdbId              String?
  traktId             Int?
  tvdbId              Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  releases          Release[]
  sourceRefs        MediaSourceRef[]
  popularitySignals PopularitySignal[]
  changeEvents      ChangeEvent[]

  @@index([mediaType])
  @@index([releaseForm])
  @@index([firstReleaseDate])
  @@index([heatScore])
  @@index([tmdbId])
  @@index([tvmazeId])
  @@index([imdbId])
}

model MediaSourceRef {
  id          String   @id @default(cuid())
  mediaItemId String
  source      String
  sourceId    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  mediaItem MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)

  @@unique([source, sourceId])
  @@index([mediaItemId])
  @@index([source])
  @@index([source, isActive])
}

model Release {
  id             String   @id @default(cuid())
  mediaItemId    String
  platform       String
  region         String
  releaseDate    String?
  releaseTime    String?
  releasePattern String   @default("unknown")
  releaseStatus  String   @default("unknown")
  seasonNumber   Int?
  episodeNumber  Int?
  episodeTitle   String?
  source         String
  sourceUrl      String?  @db.Text
  fetchedAt      DateTime @default(now())

  mediaItem MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)

  @@index([releaseDate])
  @@index([platform])
  @@index([region])
  @@index([source])
}

model PopularitySignal {
  id              String   @id @default(cuid())
  mediaItemId     String
  sourceSyncRunId String?
  source          String
  sourceCategory  String
  platform        String?
  region          String?
  window          String
  rank            Int?
  previousRank    Int?
  rankDelta       Int?
  value           Float?
  valueLabel      String?
  capturedAt      DateTime @default(now())
  isCurrent       Boolean  @default(true)
  sourceUrl       String?  @db.Text

  mediaItem     MediaItem      @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  sourceSyncRun SourceSyncRun? @relation(fields: [sourceSyncRunId], references: [id], onDelete: SetNull)

  @@index([source])
  @@index([window])
  @@index([rank])
  @@index([capturedAt])
  @@index([mediaItemId, source, isCurrent])
  @@index([source, window, isCurrent, rank])
  @@index([capturedAt, isCurrent])
  @@index([sourceSyncRunId])
}

model SourceSyncRun {
  id           String    @id @default(cuid())
  source       String
  scope        String    @default("all")
  status       String
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  durationMs   Int?
  itemCount    Int       @default(0)
  errorMessage String?   @db.Text
  nextRunAt    DateTime?

  popularitySignals PopularitySignal[]

  @@index([source])
  @@index([source, scope])
  @@index([status])
  @@index([startedAt])
}

model ChangeEvent {
  id          String   @id @default(cuid())
  mediaItemId String?
  eventType   String
  title       String
  description String   @db.Text
  source      String
  sourceUrl   String?  @db.Text
  eventAt     DateTime @default(now())
  payload     String   @default("{}")

  mediaItem MediaItem? @relation(fields: [mediaItemId], references: [id], onDelete: SetNull)

  @@index([eventType])
  @@index([eventAt])
  @@index([source])
}
